    "micro": {
      "$value": "0.625rem",
      "$description": "Badges and tile labels. rem, so the text-size setting reaches it; a px size does not."
    },
    "body-sm": {
      "$value": "0.875rem",
      "$description": "Secondary body copy, form hints, table rows."
